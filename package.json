{
  "name": "@vrwarp/brother-ql-webusb",
  "version": "0.1.0",
  "description": "Print to Brother QL and P-touch label printers directly from the browser via WebUSB. TypeScript port of the brother_ql raster protocol.",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "keywords": [
    "brother",
    "brother-ql",
    "label-printer",
    "webusb",
    "thermal-printer",
    "raster",
    "QL-800",
    "QL-820NWB",
    "P-touch"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vrwarp/brother_ql.git"
  },
  "homepage": "https://github.com/vrwarp/brother_ql#readme",
  "bugs": {
    "url": "https://github.com/vrwarp/brother_ql/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "python3 scripts/generate_fixtures.py",
    "fixtures:check": "python3 scripts/generate_fixtures.py --check",
    "demo:dev": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts",
    "demo:preview": "vite preview --config demo/vite.config.ts",
    "prepublishOnly": "npm run build",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@types/w3c-web-usb": "^1.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.17.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
